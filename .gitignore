# ────────────────────────────────
# Logs
# ────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ────────────────────────────────
# Front-end artefacts
# ────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local          # archivos locales de Vite/React (ej. .local envs)

# ────────────────────────────────
# Back-end (Python / FastAPI)
# ────────────────────────────────
backend/venv/
backend/__pycache__/
backend/.pytest_cache/
backend/.mypy_cache/
backend/*.py[cod]

# Si alguna vez tu venv queda afuera de /backend, ignórala también:
venv/

# ────────────────────────────────
# Variables de entorno y secretos
# ────────────────────────────────
.env
.env.*
*.env

# ────────────────────────────────
# Directorios y archivos de editores/IDE
# ────────────────────────────────
.vscode/*
!.vscode/extensions.json   # <- se mantiene la lista de extensiones recomendadas
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
